generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  farmer
  consumer
  admin

  @@map("user_role")
}

enum OrderStatus {
  pending
  confirmed
  harvesting
  shipped
  completed
  cancelled

  @@map("order_status")
}

enum DeliveryMethod {
  regular
  cold_chain

  @@map("delivery_method")
}

model Profile {
  id             String         @id @db.Uuid
  role           UserRole       @default(consumer)
  name           String         @default("")
  phone          String?
  avatarUrl      String?        @map("avatar_url")
  city           String?        @default("Jakarta")
  province       String?        @default("DKI Jakarta")
  loyaltyPoints  Int            @default(0) @map("loyalty_points")
  totalOrders    Int            @default(0) @map("total_orders")
  totalReviews   Int            @default(0) @map("total_reviews")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  farmerProfile  FarmerProfile?
  products       Product[]
  consumerOrders Order[]        @relation("ConsumerOrders")
  farmerOrders   Order[]        @relation("FarmerOrders")
  reviews        Review[]

  @@map("profiles")
}

model FarmerProfile {
  id          String   @id @db.Uuid
  location    String   @default("")
  province    String   @default("")
  specialty   String?
  isVerified  Boolean  @default(false) @map("is_verified")
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")
  distanceKm  Decimal  @default(0) @map("distance_km") @db.Decimal(6, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile     Profile  @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("farmer_profiles")
}

model Category {
  id        String    @id
  name      String
  iconEmoji String?   @map("icon_emoji")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id                   String    @id @default(uuid()) @db.Uuid
  farmerId             String    @map("farmer_id") @db.Uuid
  name                 String
  description          String    @default("")
  price                Decimal   @db.Decimal(14, 2)
  unit                 String    @default("kg")
  rating               Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount          Int       @default(0) @map("review_count")
  stock                Decimal   @default(0) @db.Decimal(10, 2)
  category             String?
  imageUrls            String[]  @default([]) @map("image_urls")
  isAvailable          Boolean   @default(true) @map("is_available")
  isAiPrice            Boolean   @default(false) @map("is_ai_price")
  isPreOrder           Boolean   @default(false) @map("is_pre_order")
  estimatedHarvestDate DateTime? @map("estimated_harvest_date") @db.Date
  preOrderTarget       Decimal?  @map("pre_order_target") @db.Decimal(10, 2)
  preOrderFilled       Decimal?  @default(0) @map("pre_order_filled") @db.Decimal(10, 2)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  farmer               Profile   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  categoryRef          Category? @relation(fields: [category], references: [id])
  reviews              Review[]

  @@map("products")
}

model Order {
  id                String         @id @default(dbgenerated("('ORD-' || lpad(nextval('order_seq')::text, 6, '0'))"))
  consumerId        String?        @map("consumer_id") @db.Uuid
  productId         String?        @map("product_id") @db.Uuid
  productName       String         @map("product_name")
  productImageUrl   String?        @default("") @map("product_image_url")
  farmerName        String?        @default("") @map("farmer_name")
  farmerId          String?        @map("farmer_id") @db.Uuid
  quantity          Decimal        @db.Decimal(10, 2)
  unit              String         @default("kg")
  pricePerUnit      Decimal        @map("price_per_unit") @db.Decimal(14, 2)
  shippingCost      Decimal        @default(0) @map("shipping_cost") @db.Decimal(14, 2)
  status            OrderStatus    @default(pending)
  deliveryMethod    DeliveryMethod @default(regular) @map("delivery_method")
  estimatedDelivery DateTime?      @map("estimated_delivery")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  consumer          Profile?       @relation("ConsumerOrders", fields: [consumerId], references: [id])
  farmer            Profile?       @relation("FarmerOrders", fields: [farmerId], references: [id])
  trackingSteps     OrderTrackingStep[]
  reviews           Review[]

  @@map("orders")
}

model OrderTrackingStep {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id")
  stepOrder   Int       @map("step_order")
  title       String
  isCompleted Boolean   @default(false) @map("is_completed")
  isActive    Boolean   @default(false) @map("is_active")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_tracking_steps")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  consumerId String?  @map("consumer_id") @db.Uuid
  orderId    String?  @map("order_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  consumer   Profile? @relation(fields: [consumerId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@map("reviews")
}

model MarketEvent {
  id          String    @id @default(uuid()) @db.Uuid
  emoji       String?
  title       String
  description String?
  impact      String?
  eventDate   DateTime? @map("event_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("market_events")
}
