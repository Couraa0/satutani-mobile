# Salin file ini ke .env dan isi nilainya
# Dapatkan nilai dari: https://supabase.com/dashboard > Project Settings > API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Untuk Google OAuth (opsional)
# Dapatkan dari: https://console.cloud.google.com > Credentials
SUPABASE_AUTH_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxx
